# Copy to .env and fill in. Never commit .env (INF-13: no hardcoded secrets).

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_dev_local
POSTGRES_DB=jarvis

# LLM Router (infra/llm_router.py). Leave any blank to disable that
# provider — the Router falls back to the next one, and to deterministic
# templates if all six are unavailable.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Added 2026-09-08 for free-tier resilience — see
# V1_M5_IMPLEMENTATION_RECORD.md's 2026-09-08 entry.
ZAI_API_KEY=
CODECRAFT_API_KEY=
# Any GitHub personal access token with the `models` scope — not a
# service-specific key. See that record entry for how to create one.
GITHUB_TOKEN=
