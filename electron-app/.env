# Copy this file to `.env` (same folder) and fill in your paths.
# main.js loads this automatically on every launch — no more manual
# `export` before `npm start`.

# Path to your jarvis repo checkout (the folder containing server/app.py)
NIKA_REPO_PATH=/home/hakatatanoodle/Projects/Jarvis/jarvis-desktop/jarvis

# Path to a downloaded Piper voice .onnx file (its matching .onnx.json
# must sit next to it). Leave unset/commented to disable voice output —
# chat still works fine without it.
NIKA_PIPER_VOICE=/home/hakatatanoodle/nika-voices/en_US-lessac-medium.onnx

# Optional — override the default whisper model size for voice input.
# NIKA_WHISPER_MODEL=base.en

