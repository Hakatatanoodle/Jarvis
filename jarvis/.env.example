# Copy to .env and fill in. Never commit .env (INF-13: no hardcoded secrets).

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_dev_local
POSTGRES_DB=jarvis

# LLM Router (infra/llm_router.py). Leave any blank to disable that
# provider — the Router falls back to the next one, and to deterministic
# templates if all are unavailable.
OPENROUTER_API_KEY=
# Added 2026-09-08 for free-tier resilience — see
# V1_M5_IMPLEMENTATION_RECORD.md's 2026-09-08 entry.
ZAI_API_KEY=
CODECRAFT_API_KEY=
# Any GitHub personal access token with the `models` scope — not a
# service-specific key. See that record entry for how to create one.
GITHUB_TOKEN=
# Added 2026-09-11: the person's self-hosted LiteLLM proxy (see
# docker-compose.yml/config.yaml, and V1_M5_IMPLEMENTATION_RECORD.md's
# 2026-09-11 entry) now fronts Gemini and Groq — GROQ_API_KEY/
# GEMINI_API_KEY moved OUT of this file and INTO that proxy's own .env
# (docker-compose's env_file), since Jarvis no longer calls either
# directly. This must be the exact same value as that proxy's
# general_settings.master_key / LITELLM_MASTER_KEY — Jarvis sends it as
# the proxy's own auth, not a per-provider key.
LITELLM_MASTER_KEY=

# Capabilities V2: web.search (Tavily). Free key at https://tavily.com
TAVILY_API_KEY=
